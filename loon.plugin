#!name=Private Repo
#!desc=访问私有仓库

[Argument]
TOKEN = input, "", tag=TOKEN, desc=GitHub Token

[Rewrite]
# 解决github速率限制返回429问题
^https://.*\.githubusercontent\.com\/ header-replace Accept-Language en-us

[Script]
http-request ^https:\/\/(raw|gist)\.githubusercontent\.com script-path=loon.js, requires-body=false, timeout=20, argument=[{TOKEN}], tag=PrivateRepo

[MITM]
hostname = *.githubusercontent.com