#!name=Private Repo
#!desc=访问私有仓库

[Argument]
USERNAME=input,"",tag=USERNAME,desc=GitHub用户名
TOKEN=input,"",tag=TOKEN,desc=GitHub Token

[Script]
cron "0 */1 * * *" script-path=https://raw.githubusercontent.com/yangsijianjian/loon/refs/heads/main/loon.js, requires-body=true, timeout=20, argument=USERNAME={{{USERNAME}}}&TOKEN={{{TOKEN}}}, tag=PrivateRepo

#http-request ^https:\/\/raw\.githubusercontent\.com\/yangsijianjian\/yangsijian\/ script-path=https://raw.githubusercontent.com/yangsijianjian/loon/refs/heads/main/loon.js, requires-body=true, timeout=20, argument=USERNAME={{{USERNAME}}}&TOKEN={{{TOKEN}}}, tag=PrivateRepo

[MITM]
hostname = raw.githubusercontent.com, gist.githubusercontent.com